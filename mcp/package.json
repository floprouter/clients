{
  "name": "floprouter-mcp",
  "version": "0.1.3",
  "description": "MCP server for the floprouter API: FLOP Network models and miners, paid chat completions, sessions, balance and grants for AI agents",
  "author": "floprouter",
  "license": "MIT",
  "homepage": "https://floprouter.com",
  "type": "module",
  "bin": {
    "floprouter-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node scripts/sync-shared.mjs --check && node test/offline.mjs && node test/renewal.mjs",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "start": "node src/index.js",
    "smoke": "node test/smoke.mjs",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "keywords": [
    "floprouter",
    "flop",
    "mcp",
    "model-context-protocol",
    "llm",
    "inference"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3"
  },
  "peerDependenciesMeta": {
    "@polkadot/api": {
      "optional": true
    },
    "@polkadot/keyring": {
      "optional": true
    },
    "@polkadot/util": {
      "optional": true
    },
    "@polkadot/util-crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floprouter/clients.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/floprouter/clients/issues"
  }
}
